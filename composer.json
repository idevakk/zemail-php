{
    "name": "zemailme/zemail-php",
    "description": "The official PHP SDK for Zemail Developer API.",
    "type": "library",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "ext-json": "*"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2",
        "laravel/pint": "^1.30"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Zemail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zemail\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Zemail Support",
            "email": "support@zemail.me"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:types": "phpstan analyse",
        "format": "pint"
    }
}
